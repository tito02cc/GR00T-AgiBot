# Cloud instance configuration; no credentials. Keep this task's splits separate.
export CT_ROOT=/root/gpufree-data/GR00T
export GROOT_REPO_ROOT=${CT_ROOT}/Isaac-GR00T
export GROOT_BASE_MODEL=${CT_ROOT}/models/GR00T-N1.7-3B
export GROOT_BACKBONE_MODEL=${CT_ROOT}/models/Cosmos-Reason2-2B
export GROOT_DATASET=${CT_ROOT}/datasets/zhewan_right_place_r0003_400/train
export GROOT_MODALITY_CONFIG=${GROOT_REPO_ROOT}/agibot/configs/zhewan_right_place_config.py
export GROOT_DATASET_VALIDATION=inventory
export GROOT_DATASET_INVENTORY=${CT_ROOT}/manifests/zhewan_right_place_r0003_train.inventory.json
export GROOT_EMBODIMENT_TAG=NEW_EMBODIMENT
export GROOT_USE_PERCENTILES=false
export RUN_ID=zhewan_rplace_r0003_n1d7_e400_f10_h16_1xa10080_s30k_ckpt5k_v1
export GROOT_MAX_STEPS=30000
export GROOT_SAVE_STEPS=5000
export GROOT_SAVE_TOTAL_LIMIT=2
# Batch 16 per forward x 2 gradient accumulation = 32 per optimizer step.
export GROOT_GLOBAL_BATCH_SIZE=16
export GROOT_GRADIENT_ACCUMULATION_STEPS=2
export GROOT_DATALOADER_WORKERS=4
export GROOT_LOGGING_STEPS=10
export GROOT_LEARNING_RATE=1e-4
export GROOT_WEIGHT_DECAY=1e-5
export GROOT_WARMUP_RATIO=0.05
export GROOT_STATE_DROPOUT_PROB=0.2
export GROOT_EPISODE_SAMPLING_RATE=0.1
export GROOT_SHARD_SIZE=1024
export GROOT_SMOKE_STEPS=100
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
